---
import Base from '../layouts/Base.astro';
import BiasBar from '../components/BiasBar.astro';
import EventRow from '../components/EventRow.astro';
import { getEvents, blindspotLabel, fmtDate } from '../lib/events';

const events = await getEvents();
const [hero, ...rest] = events;
const totalArticles = events.reduce((n, e) => n + e.articleCount, 0);
const outletsUsed = new Set(events.flatMap((e) => e.coverage.map((c) => c.outlet.id))).size;
const blindspots = events.filter((e) => e.blindspot);
const latest = [...events].sort((a, b) => b.lastSeen.localeCompare(a.lastSeen));
const briefing = latest.slice(0, 5);
const main = rest.slice(0, 8);
const more = rest.slice(8);
---
<Base title="Punkt Widzenia" description="Najważniejsze wydarzenia w Polsce i to, jak opisują je media z lewa, z centrum i z prawa. Porównaj nagłówki, zobacz rozkład źródeł i ślepe plamki.">
  <div class="home">
    <aside class="col-left" aria-labelledby="brief-h">
      <h2 id="brief-h" class="col-h">Przegląd dnia</h2>
      <div class="brief brief-card">
        <p class="brief-stats">{events.length} wydarzeń · {totalArticles} artykułów · {outletsUsed} redakcji</p>
        <h3><a href={`/wydarzenie/${briefing[0].id}/`}>{briefing[0].title}</a></h3>
        <p class="muted">{briefing[0].summary[0]}</p>
        <p class="brief-more">
          + {briefing.slice(1).map((e, i) => (
            <>
              <a href={`/wydarzenie/${e.id}/`}>{e.title.split(/[.:]/)[0]}</a>{i < briefing.length - 2 ? '; ' : '.'}
            </>
          ))}
        </p>
      </div>
      <h2 class="col-h">Ostatnio aktualizowane</h2>
      {latest.slice(5, 9).map((e) => <EventRow event={e} compact />)}
    </aside>

    <section class="col-main" aria-label="Najważniejsze wydarzenia">
      <a class="hero" href={`/wydarzenie/${hero.id}/`}>
        <span class="hero-kicker">{hero.location} · {fmtDate(hero.date)} · {hero.sourceCount} źródeł</span>
        <span class="hero-title">{hero.title}</span>
        <BiasBar pct={hero.pct} />
      </a>
      {main.map((e) => <EventRow event={e} />)}
      {more.length > 0 && (
        <>
          <h2 class="col-h">Więcej wydarzeń</h2>
          {more.map((e) => <EventRow event={e} />)}
        </>
      )}
    </section>

    <aside class="col-right" aria-labelledby="bs-h">
      <h2 id="bs-h" class="bs-title"><span aria-hidden="true">◐</span> Ślepe plamki</h2>
      <p class="muted small">
        Wydarzenia opisywane głównie przez jedną stronę sceny politycznej. <a href="/slepe-plamki/">Czym jest ślepa plamka?</a>
      </p>
      {blindspots.length === 0 && <p class="muted">Brak ślepych plamek w tym zestawie.</p>}
      {blindspots.slice(0, 4).map((e) => (
        <a class:list={['bs-card', e.blindspot]} href={`/wydarzenie/${e.id}/`}>
          <span class="bs-tag">{blindspotLabel[e.blindspot!]}</span> <span class="muted small">{e.sourceCount} źródeł</span>
          <span class="bs-card-title">{e.title}</span>
          <BiasBar pct={e.pct} />
        </a>
      ))}
      <a class="btn-outline" href="/slepe-plamki/">Wszystkie ślepe plamki</a>

      <h2 class="col-h">Kto pisze o czym</h2>
      <p class="muted small">
        Każde wydarzenie pokazuje, które z {30} monitorowanych redakcji je opisały, jak rozkładają się po osi lewica–prawica i rząd–opozycja oraz kto milczy.
        Oceny redakcji: <a href="/media/">katalog mediów</a> i <a href="/metodologia/">metodologia</a>.
      </p>
    </aside>
  </div>
</Base>
