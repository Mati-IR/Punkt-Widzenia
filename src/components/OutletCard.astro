---
import type { CollectionEntry } from 'astro:content';
import { classicLabel, polishLabel, ownershipLabel, segmentLabel, reliabilityLabel, typeLabel } from '../lib/labels';

interface Props {
  outlet: CollectionEntry<'outlets'>;
}
const { outlet } = Astro.props;
const d = outlet.data;
const signed = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${-n}` : '0');
const c = d.leaning.classic;
const contested = d.leaning.classic.contested || d.leaning.polish.contested || d.reliability.contested;
---
<li
  data-outlet
  data-name={d.name.toLowerCase()}
  data-classic={d.leaning.classic.value}
  data-polish={d.leaning.polish.value}
  data-ownership={[d.ownership.category, ...d.ownership.secondaryTags].join(' ')}
  data-segment={d.segment}
>
  <article class="card">
    <h3><a href={`/media/${outlet.id}/`}>{d.name}</a></h3>
    <p class="meta">{typeLabel[d.type]}</p>
    <ul class="tags" aria-label="Cechy">
      <li class:list={['tag', { indep: d.segment === 'independent' }]}>{segmentLabel[d.segment]}</li>
      <li class="tag">{ownershipLabel[d.ownership.category]}</li>
      {contested && <li class="tag warn">Sporne</li>}
    </ul>
    <dl class="kv">
      <dt>Lewica–prawica</dt>
      <dd><span class="lean"><span class:list={['dot', d.leaning.classic.value]} aria-hidden="true"></span>{classicLabel[c.value]}</span> <span class="meta" title="Gospodarka / sprawy społeczne (−2…+2)"><span class="sr-only">gospodarka i sprawy społeczne: </span>{signed(c.economic)} / {signed(c.sociocultural)}</span></dd>
      <dt>Rząd–opozycja</dt>
      <dd>{polishLabel[d.leaning.polish.value]}</dd>
      <dt>Wiarygodność</dt>
      <dd>{reliabilityLabel[d.reliability.label]} ({d.reliability.total}/6){d.reliability.provisional && <> <span class="tag prov">wstępna</span></>}</dd>
    </dl>
  </article>
</li>
