---
// One event in a list: tag line, title, mini bias bar, source count and the AI label.
// Markup comes from eventRowHtml() so rows loaded by infinite scroll (/feed/N.json) look the same.
import { eventRowHtml, type NewsEvent } from '../lib/events';
interface Props {
  event: NewsEvent;
  compact?: boolean;
}
const { event, compact = false } = Astro.props;
---
<Fragment set:html={eventRowHtml(event, compact)} />
