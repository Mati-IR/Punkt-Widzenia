// Cloudflare Worker that serves the built static site (dist/) and, every 2 h, starts the
// "Ingest headlines" GitHub Action (worker/index.js; GitHub's own cron skips most runs).
// Used by Workers Builds (deploy command: npx wrangler deploy) and by the ingest Action.
// The empty `previews` block lets `npx wrangler preview` (non-production branch builds) run too.
{
  "name": "punkt-widzenia",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "triggers": {
    "crons": ["17 */2 * * *"]
  },
  "previews": {},
  // Matches the dashboard settings so a deploy doesn't reset them: Worker logs on and kept
  // (so failed cron runs are visible), traces and issue detection off.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
