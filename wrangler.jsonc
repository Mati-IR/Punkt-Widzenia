// Cloudflare Worker that serves the built static site (dist/). No server code.
// Used by Workers Builds (deploy command: npx wrangler deploy) and by the ingest Action.
// The empty `previews` block lets `npx wrangler preview` (non-production branch builds) run too.
{
  "name": "punkt-widzenia",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "previews": {}
}
